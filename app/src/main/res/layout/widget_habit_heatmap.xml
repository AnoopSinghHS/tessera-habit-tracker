<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="14dp">

    <!-- Top Editorial Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Metadata Cluster (Tappable to open Habit Detail Sheet) -->
        <LinearLayout
            android:id="@+id/widget_header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Architectural Geometric Mark Badge -->
            <TextView
                android:id="@+id/widget_color_dot"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_streak_badge_bg"
                android:gravity="center"
                android:text="◆"
                android:textColor="#B85435"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_habit_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Deep Work"
                        android:textColor="#F5F3EF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_streak_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_streak_badge_bg"
                        android:fontFamily="serif"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="14 day streak"
                        android:textColor="#C27D38"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_habit_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text="deep-work · Completed today"
                    android:textColor="#9A948A"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tactile 32dp Circular 1-Tap Check-In Button -->
        <TextView
            android:id="@+id/widget_check_in_btn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/widget_btn_checkin_active"
            android:contentDescription="@string/widget_checkin_content_desc"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="✓"
            android:textColor="#F5F3EF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- High-DPI Rendered 18-Week Contribution Mosaic -->
    <ImageView
        android:id="@+id/widget_heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_heatmap_content_desc"
        android:scaleType="fitXY" />

</LinearLayout>
