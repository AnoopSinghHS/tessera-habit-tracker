<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <!-- Top Architectural Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left Metadata Cluster (Tappable to open Habit Detail Sheet) -->
        <LinearLayout
            android:id="@+id/widget_header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Accent Color Indicator Badge -->
            <TextView
                android:id="@+id/widget_color_dot"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/widget_streak_badge_bg"
                android:gravity="center"
                android:text="⚡"
                android:textColor="#34D399"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widget_habit_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Deep Work Session"
                        android:textColor="#F3F4F6"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/widget_streak_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/widget_streak_badge_bg"
                        android:fontFamily="monospace"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="14D STREAK"
                        android:textColor="#34D399"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_habit_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="monospace"
                    android:maxLines="1"
                    android:text="#deep-work · 1/2 TODAY"
                    android:textColor="#8A919E"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Direct 1-Tap Check-In Button -->
        <TextView
            android:id="@+id/widget_check_in_btn"
            android:layout_width="36dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_btn_checkin_active"
            android:contentDescription="@string/widget_checkin_content_desc"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="+1"
            android:textColor="#F3F4F6"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- High-DPI Rendered 18-Week GitHub Contribution Matrix -->
    <ImageView
        android:id="@+id/widget_heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_heatmap_content_desc"
        android:scaleType="fitXY" />

</LinearLayout>
