<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 widget. Colours here are the light defaults; HabitWidgetUpdater sets them per widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Habit name and streak; opens the habit in the app. -->
        <LinearLayout
            android:id="@+id/widget_header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_habit_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Read 20 pages"
                android:textColor="@color/widget_light_text"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_streak_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="14-day streak"
                    android:textColor="@color/widget_light_accent"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/widget_habit_subtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:text=" · Done today"
                    android:textColor="@color/widget_light_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Check-in: 48dp touch area around a 40dp circle. -->
        <FrameLayout
            android:id="@+id/widget_check_in_btn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/widget_checkin_content_desc">

            <TextView
                android:id="@+id/widget_check_in_label"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:background="@drawable/widget_btn_checkin_done_light"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="✓"
                android:textColor="@color/widget_light_on_accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </FrameLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/widget_heatmap_image"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:adjustViewBounds="false"
        android:contentDescription="@string/widget_heatmap_content_desc"
        android:scaleType="fitXY" />

</LinearLayout>
